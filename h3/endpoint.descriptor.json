  "entrypoints": [
    {
      "capabilities": [
        "save",
        "telemetry"
      ],
      "gpu": true,
      "hidden": false,
      "kind": "entrypoint",
      "models": [
        {
          "class": "Fl2VAModel",
          "component_use": {
            "condition_text": [
              "text_encoder"
            ],
            "condition_visual": [
              "video_vae"
            ],
            "decode_audio": [
              "audio_vae"
            ],
            "decode_video": [
              "video_vae"
            ],
            "predict_data_velocity": [
              "transformer"
            ]
          },
          "param": "model",
          "path": "generate.models.model",
          "stamps": {
            "task": "fl2va"
          }
        }
      ],
      "name": "generate",
      "request": {
        "fields": [
          {
            "name": "prompt",
            "type": "str",
            "wire": "required"
          },
          {
            "default": null,
            "name": "first_frame",
            "type": {
              "union": [
                "null",
                {
                  "asset": "image"
                }
              ]
            },
            "wire": "optional"
          },
          {
            "default": null,
            "name": "last_frame",
            "type": {
              "union": [
                "null",
                {
                  "asset": "image"
                }
              ]
            },
            "wire": "optional"
          },
          {
            "default": "16:9",
            "name": "aspect_ratio",
            "shape_axes": [
              "width",
              "height",
              "pixels"
            ],
            "type": {
              "enum": "AspectPreset",
              "values": [
                "16:9",
                "1:1",
                "21:9",
                "3:4",
                "4:3",
                "9:16",
                "9:21"
              ]
            },
            "wire": "optional"
          },
          {
            "default": 5,
            "name": "duration_s",
            "shape_axes": [
              "frames"
            ],
            "type": {
              "literal": [
                10,
                11,
                12,
                13,
                14,
                15,
                5,
                6,
                7,
                8,
                9
              ]
            },
            "wire": "optional"
          },
          {
            "default": 30,
            "default_sources": [
              "code_fallback",
              "checkpoint_recipe",
              "adapter_recipe",
              "request"
            ],
            "name": "num_inference_steps",
            "type": {
              "literal": [
                20,
                30,
                50
              ]
            },
            "wire": "omissible"
          },
          {
            "default": false,
            "name": "mute",
            "type": "bool",
            "wire": "optional"
          },
          {
            "default": null,
            "name": "seed",
            "type": {
              "union": [
                "int",
                "null"
              ]
            },
            "wire": "optional"
          }
        ],
        "forbid_unknown_fields": true,
        "struct": "GenerateInput"
      },
      "request_features": [
        {
          "axis": "frames",
          "field": "duration_s",
          "source": "shape"
        },
        {
          "axis": "height",
          "field": "aspect_ratio",
          "source": "shape"
        },
        {
          "axis": "pixels",
          "field": "aspect_ratio",
          "source": "shape"
        },
        {
          "axis": "steps",
          "field": "num_inference_steps",
          "source": "field"
        },
        {
          "axis": "width",
          "field": "aspect_ratio",
          "source": "shape"
        }
      ],
      "result": {
        "fields": [
          {
            "name": "video",
            "type": {
              "asset": "video"
            },
            "wire": "required"
          },
          {
            "name": "width",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "height",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "frames",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "fps",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "steps",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "plan_digest",
            "type": "str",
            "wire": "required"
          },
          {
            "name": "video_digest",
            "type": "str",
            "wire": "required"
          },
          {
            "name": "audio_digest",
            "type": "str",
            "wire": "required"
          },
          {
            "name": "checkpoint",
            "type": "str",
            "wire": "required"
          }
        ],
        "struct": "GenerateOutput"
      }
    }
  ],
  "error_model": {
    "author_raises": [
