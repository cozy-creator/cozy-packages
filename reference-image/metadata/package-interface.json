{
  "format": "cozy.package.interface/1",
  "application": "reference_image:app",
  "entrypoints": [
    {
      "name": "generate",
      "request": {
        "fields": [
          {
            "name": "prompt",
            "type": "str",
            "constraints": {
              "min_length": 1
            }
          },
          {
            "name": "width",
            "type": "int",
            "wire": "optional",
            "constraints": {
              "ge": 256,
              "le": 2752,
              "multiple_of": 32
            }
          },
          {
            "name": "height",
            "type": "int",
            "wire": "optional",
            "constraints": {
              "ge": 256,
              "le": 2752,
              "multiple_of": 32
            }
          },
          {
            "name": "steps",
            "type": "int",
            "wire": "optional",
            "constraints": {
              "ge": 1,
              "le": 100
            }
          },
          {
            "name": "seed",
            "type": {
              "union": [
                "int",
                "null"
              ]
            },
            "wire": "optional"
          },
          {
            "name": "background",
            "type": {
              "literal": [
                "normal",
                "white"
              ]
            },
            "wire": "optional"
          }
        ]
      },
      "result": {
        "fields": [
          {
            "name": "image",
            "type": {
              "asset": "image"
            },
            "asset_bound": {
              "max_bytes": 33554432,
              "media_types": [
                "image/png"
              ]
            }
          },
          {
            "name": "width",
            "type": "int"
          },
          {
            "name": "height",
            "type": "int"
          },
          {
            "name": "seed",
            "type": "int"
          }
        ]
      },
      "models": [
        {
          "path": "generate.models.model",
          "class": "QwenImage21Model",
          "encoded_leaves": "refuse",
          "component_use": {
            "decode": [
              "vae"
            ],
            "denoise": [
              "transformer"
            ],
            "encode": [
              "text_encoder"
            ]
          },
          "default_ladder": [
            {
              "gpu": "*",
              "lane": "paul/reference-image@0.1.0/original"
            }
          ]
        }
      ],
      "invocable": {
        "module": "reference_image",
        "export": "generate",
        "context": "ctx",
        "parameters": [
          "prompt",
          "width",
          "height",
          "steps",
          "seed",
          "background"
        ],
        "defaults": {
          "request/width": 1024,
          "request/height": 1024,
          "request/steps": 40,
          "request/seed": null,
          "request/background": "normal"
        },
        "type_names": {
          "request": "GenerateInput",
          "result": "ImageOutput"
        },
        "enum_members": {},
        "memoize": false,
        "capabilities": [
          "save",
          "telemetry"
        ]
      }
    }
  ],
  "jobs": []
}
