{
  "application": "sdxl:app",
  "entrypoints": [
    {
      "hidden": false,
      "models": [
        {
          "class": "SdxlModel",
          "component_use": {
            "decode": [
              "vae"
            ],
            "denoise": [
              "unet"
            ],
            "encode": [
              "text_encoder",
              "text_encoder_2"
            ]
          },
          "param": "model",
          "path": "generate.models.model",
          "stamps": {}
        }
      ],
      "name": "generate",
      "request": {
        "fields": [
          {
            "name": "prompt",
            "type": "str",
            "wire": "optional"
          },
          {
            "name": "negative_prompt",
            "type": "str",
            "wire": "optional"
          },
          {
            "name": "aspect_ratio",
            "type": {
              "literal": [
                "16:9",
                "1:1",
                "3:4",
                "4:3",
                "9:16"
              ]
            },
            "wire": "optional"
          },
          {
            "constraints": {
              "ge": 1,
              "le": 50
            },
            "name": "steps",
            "type": "int",
            "wire": "omissible"
          },
          {
            "constraints": {
              "ge": 0.0,
              "le": 20.0
            },
            "name": "guidance",
            "type": "float",
            "wire": "omissible"
          },
          {
            "name": "seed",
            "type": "int",
            "wire": "optional"
          }
        ]
      },
      "result": {
        "fields": [
          {
            "name": "image",
            "type": {
              "asset": "image"
            },
            "wire": "required"
          },
          {
            "name": "width",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "height",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "steps",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "guidance",
            "type": "float",
            "wire": "required"
          },
          {
            "name": "classifier_free",
            "type": "bool",
            "wire": "required"
          },
          {
            "name": "digest",
            "type": "str",
            "wire": "required"
          }
        ]
      }
    }
  ],
  "format": "cozy.endpoint.descriptor/1",
  "jobs": []
}
