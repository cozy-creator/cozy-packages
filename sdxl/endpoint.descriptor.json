{
  "application": "sdxl:app",
  "config_schema": {},
  "context_facts": [
    {
      "kind": "attribute",
      "name": "boot_warmup"
    },
    {
      "kind": "attribute",
      "name": "cancelled"
    },
    {
      "kind": "attribute",
      "name": "deadline"
    },
    {
      "kind": "attribute",
      "name": "device"
    },
    {
      "kind": "method",
      "name": "raise_if_cancelled"
    },
    {
      "kind": "attribute",
      "name": "request_id"
    }
  ],
  "entrypoints": [
    {
      "capabilities": [
        "save",
        "telemetry"
      ],
      "gpu": true,
      "kind": "entrypoint",
      "models": [
        {
          "class": "SdxlModel",
          "component_use": {
            "decode": [
              "vae"
            ],
            "denoise": [
              "unet"
            ],
            "encode": [
              "text_encoder",
              "text_encoder_2"
            ]
          },
          "param": "model",
          "path": "generate.models.model",
          "stamps": {}
        }
      ],
      "name": "generate",
      "request": {
        "fields": [
          {
            "default": "a photograph of an astronaut riding a horse",
            "name": "prompt",
            "type": "str",
            "wire": "optional"
          },
          {
            "default": "",
            "name": "negative_prompt",
            "type": "str",
            "wire": "optional"
          },
          {
            "default": "1:1",
            "name": "aspect_ratio",
            "shape_axes": [
              "width",
              "height",
              "pixels"
            ],
            "type": {
              "enum": "AspectRatio",
              "values": [
                "16:9",
                "1:1",
                "3:4",
                "4:3",
                "9:16"
              ]
            },
            "wire": "optional"
          },
          {
            "constraints": {
              "ge": 1,
              "le": 50
            },
            "default": 20,
            "default_sources": [
              "code_fallback",
              "checkpoint_recipe",
              "adapter_recipe",
              "request"
            ],
            "name": "steps",
            "type": "int",
            "wire": "omissible"
          },
          {
            "constraints": {
              "ge": 0.0,
              "le": 20.0
            },
            "default": 5.0,
            "default_sources": [
              "code_fallback",
              "checkpoint_recipe",
              "adapter_recipe",
              "request"
            ],
            "name": "guidance",
            "type": "float",
            "wire": "omissible"
          },
          {
            "default": 1005,
            "name": "seed",
            "type": "int",
            "wire": "optional"
          }
        ],
        "forbid_unknown_fields": true,
        "struct": "Txt2ImgInput"
      },
      "request_features": [
        {
          "axis": "height",
          "field": "aspect_ratio",
          "source": "shape"
        },
        {
          "axis": "pixels",
          "field": "aspect_ratio",
          "source": "shape"
        },
        {
          "axis": "steps",
          "field": "steps",
          "source": "field"
        },
        {
          "axis": "width",
          "field": "aspect_ratio",
          "source": "shape"
        }
      ],
      "result": {
        "fields": [
          {
            "name": "image",
            "type": {
              "asset": "image"
            },
            "wire": "required"
          },
          {
            "name": "width",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "height",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "steps",
            "type": "int",
            "wire": "required"
          },
          {
            "name": "guidance",
            "type": "float",
            "wire": "required"
          },
          {
            "name": "classifier_free",
            "type": "bool",
            "wire": "required"
          },
          {
            "name": "digest",
            "type": "str",
            "wire": "required"
          }
        ],
        "struct": "ImageOutput"
      }
    }
  ],
  "error_model": {
    "author_raises": [
      "InvalidRequest",
      "UnsupportedInput",
      "Cancelled",
      "exception"
    ],
    "origins": [
      "author",
      "request",
      "runtime"
    ],
    "retryability": "a coordinator projection over these facts; never author-declared",
    "terminals": [
      "succeeded",
      "refused",
      "failed",
      "canceled"
    ]
  },
  "jobs": [],
  "protocol": {
    "python_contract_max": "0.0.1",
    "python_contract_min": "0.0.1",
    "wire_minor_max": 0,
    "wire_minor_min": 0,
    "wire_package": "cozy.worker.v1"
  },
  "schema": "cozy.endpoint.descriptor/1",
  "secret_schema": {},
  "services": {
    "adjust": {
      "members": [
        "adjusted",
        "clamp",
        "warn"
      ],
      "service": "Adjustments"
    },
    "budget": {
      "members": [
        "elapsed_s",
        "raise_if_exhausted",
        "remaining_usd",
        "spent_usd"
      ],
      "service": "Budget"
    },
    "checkpoints": {
      "members": [
        "save"
      ],
      "service": "Checkpoints"
    },
    "egress": {
      "members": [
        "fetch"
      ],
      "service": "Egress"
    },
    "save": {
      "members": [
        "save_audio",
        "save_bytes",
        "save_file",
        "save_image",
        "save_video",
        "temporary_file"
      ],
      "service": "Outputs"
    },
    "scratch": {
      "members": [
        "checkpoint_dir",
        "materialize_blob",
        "mktemp"
      ],
      "service": "Scratch"
    },
    "secrets": {
      "members": [],
      "service": "Secrets"
    },
    "settings": {
      "members": [],
      "service": "Settings"
    },
    "telemetry": {
      "members": [
        "log",
        "metric",
        "progress",
        "stage",
        "step_callback",
        "training_metric"
      ],
      "service": "Telemetry"
    }
  },
  "surface_digest": "sha256:36b751bdada420b2304d006781353441ef2d685ee683cc073ca4d7c033a6a074"
}
